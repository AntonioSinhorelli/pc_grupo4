# Copie para .env (cp .env.example .env) e preencha. O .env NUNCA vai para o Git.

# --- Django ---------------------------------------------------------------
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=False
# IP público (ou Elastic IP / domínio) da EC2, separados por vírgula
ALLOWED_HOSTS=localhost,127.0.0.1,SEU_IP_PUBLICO
# Opcional: necessário se usar domínio/HTTPS (ex.: https://loja.exemplo.com)
CSRF_TRUSTED_ORIGINS=

# --- PostgreSQL (container "db") -----------------------------------------
POSTGRES_DB=lastmile
POSTGRES_USER=lastmile
POSTGRES_PASSWORD=troque-por-uma-senha-forte
# O compose já define POSTGRES_HOST=db e POSTGRES_PORT=5432 para o container web.

# --- Superusuário do Django Admin (criado no start, se não existir) -------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=troque-esta-senha

# --- Opções de execução ---------------------------------------------------
# True carrega os dados de exemplo (seed) no start; é idempotente.
SEED_ON_START=True
GUNICORN_WORKERS=2
WEB_PORT=8000
